# Groq API Keys Configuration
# ScamRadar dynamically detects ANY number of keys:
# - Single key: GROQ_API_KEY=gsk_...
# - Multiple rotated keys: GROQ_KEY_1=gsk_..., GROQ_KEY_2=gsk_...
# You can supply 1, 2, or more keys. The app will automatically rotate between them on rate limits.

GROQ_KEY_1=your_key_1_here
GROQ_KEY_2=your_key_2_here

# Optional: override default model (defaults to openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
